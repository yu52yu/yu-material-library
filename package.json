{
  "name": "yu-material-library",
  "version": "1.1.0",
  "description": "瑜的本地设计素材管理库",
  "author": "Yu",
  "packageManager": "pnpm@11.19.0",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/prepare-sites-build.mjs",
    "desktop": "vite build && electron .",
    "build:desktop": "vite build && node scripts/build-desktop.mjs",
    "preview": "vite preview",
    "test:desktop": "node --test electron/*.test.cjs tests/project-links.test.mjs tests/file-sort.test.mjs tests/file-drop.test.mjs tests/catalog-view.test.mjs tests/catalog-integration.test.mjs tests/material-areas.test.mjs",
    "test:sites": "node --test tests/sites-worker.test.mjs"
  },
  "dependencies": {},
  "devDependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "@vitejs/plugin-react": "5.0.4",
    "electron": "^44.1.1",
    "electron-builder": "^26.15.3",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "vite": "6.4.2"
  },
  "build": {
    "appId": "com.yu.materiallibrary",
    "productName": "瑜の素材库",
    "electronDist": "node_modules/electron/dist",
    "artifactName": "YuMaterialLibrary-${version}-Setup.${ext}",
    "asar": true,
    "files": [
      "dist/client/**/*",
      "electron/**/*",
      "build/knight-silver.ico",
      "package.json",
      "LICENSE"
    ],
    "extraFiles": [
      { "from": "LICENSE", "to": "LICENSE-GPL-3.0.txt" },
      "SOURCE.txt",
      "THIRD-PARTY-NOTICES.txt"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/knight-silver.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "瑜の素材库"
    }
  },
  "license": "GPL-3.0-only"
}
